# Non-secret shape only. Keep generation disabled until the internal-test activation checklist is approved.
MUSICME_AUDIO_ENVIRONMENT=production
MUSICME_AUDIO_ENGINE=fal
MUSICME_AUDIO_GENERATION_MODE=disabled
MUSICME_AUDIO_ENABLE_PRODUCTION_GENERATION=false
MUSICME_AUDIO_COMMERCIAL_RIGHTS_APPROVED=false
MUSICME_AUDIO_SECURITY_ACCEPTED=false
MUSICME_AUDIO_PUBLIC_ACTIVATION_APPROVED=false
MUSICME_AUDIO_HOST=0.0.0.0
MUSICME_AUDIO_PORT=10000
MUSICME_AUDIO_FAL_QUEUE_BASE_URL=https://queue.fal.run
MUSICME_AUDIO_FAL_CUSTOM_LYRICS_ENDPOINT=fal-ai/ace-step
MUSICME_AUDIO_FAL_PROMPT_ENDPOINT=fal-ai/ace-step/prompt-to-audio
MUSICME_AUDIO_FAL_PRICE_PER_SECOND_USD=0.0002
MUSICME_AUDIO_FAL_DAILY_BUDGET_USD=2.0
MUSICME_AUDIO_STORAGE_BACKEND=s3
MUSICME_AUDIO_OBJECT_REGION=auto
MUSICME_AUDIO_OBJECT_PREFIX=production
MUSICME_AUDIO_OBJECT_FORCE_PATH_STYLE=true
MUSICME_AUDIO_WORKERS=1
MUSICME_AUDIO_MAX_ATTEMPTS=1
MUSICME_AUDIO_MAX_TAKES=1
MUSICME_AUDIO_MIN_DURATION_SECONDS=5
MUSICME_AUDIO_MAX_DURATION_SECONDS=240
MUSICME_AUDIO_RENDER_TIMEOUT_SECONDS=600
MUSICME_AUDIO_MAX_JOBS_PER_WINDOW=3
MUSICME_AUDIO_MAX_ACTIVE_JOBS_PER_ACCOUNT=1

# Supply through Render secret/provider configuration; never commit values:
# FAL_KEY, MUSICME_AUDIO_DATABASE_URL, MUSICME_AUDIO_PUBLIC_BASE_URL,
# MUSICME_AUDIO_JWKS_URL, MUSICME_AUDIO_JWT_ISSUER, MUSICME_AUDIO_JWT_AUDIENCE,
# MUSICME_AUDIO_SIGNING_SECRET, MUSICME_AUDIO_OBJECT_ENDPOINT, MUSICME_AUDIO_OBJECT_BUCKET,
# MUSICME_AUDIO_OBJECT_ACCESS_KEY_ID, MUSICME_AUDIO_OBJECT_SECRET_ACCESS_KEY,
# MUSICME_AUDIO_INTERNAL_TEST_USER_IDS, MUSICME_AUDIO_PUBLIC_ELIGIBLE_USER_IDS
